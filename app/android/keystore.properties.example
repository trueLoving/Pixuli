# 复制为 keystore.properties 并填写（勿提交 git）。
# CI 发版：在 GitHub repo secrets 配置
# ANDROID_KEYSTORE_BASE64（keystore 文件做一次 base64，不要再套引号）、
# ANDROID_KEYSTORE_PASSWORD、ANDROID_KEY_ALIAS、ANDROID_KEY_PASSWORD。
# 证书里只有一把私钥时，ANDROID_KEY_ALIAS 可以留空，流水线会选用那一把。
# 未配置 keystore 时 release-android workflow 回退 debug 证书（仅适合内测）。
storeFile=../path/to/release.keystore
storePassword=
keyAlias=
keyPassword=
